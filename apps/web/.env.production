# Production Environment Variables for Vercel
# These will be set in Vercel dashboard

# Backend API URL (set to your Coolify backend URL)
NEXT_PUBLIC_API_URL=https://api.trailmixx.yourdomain.com

# Streaming URL (set to your Icecast server or leave as localhost for now)
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/stream
